# eonje settings (EONJE_ prefix). Copy to .env and fill in. Never commit .env.
EONJE_API_SERVICE_KEY=
EONJE_API_DAILY_LIMIT=1000
EONJE_PAGE_SIZE=9999
EONJE_STATUS_PERIOD_MIN=10
EONJE_STATUS_INTERVAL_MIN=10
# EONJE_FETCH_MAX_LAG_MIN=10   # 없으면 EONJE_STATUS_PERIOD_MIN과 같음. 그보다 클 수 없음
EONJE_SERVE_ZCODES=["11"]
EONJE_RAW_BUCKET=eonje-raw
EONJE_S3_ENDPOINT_URL="http://seaweedfs:8333"   # 개발 PC에서는 http://127.0.0.1:8333
EONJE_S3_ACCESS_KEY=
EONJE_S3_SECRET_KEY=
EONJE_DATABASE_URL=postgresql+psycopg://eonje:CHANGE_ME@postgres:5432/eonje
EONJE_API_TIMEOUT_SEC=30
EONJE_API_MAX_ATTEMPTS=3
EONJE_BUDGET_SAFETY_RATIO=0.95
EONJE_BUDGET_RESERVE_CALLS=0

# --- compose (node A) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_BIND=127.0.0.1
EONJE_DB_PASSWORD=CHANGE_ME
AIRFLOW_DB_PASSWORD=CHANGE_ME
S3_BIND=127.0.0.1
AIRFLOW_BIND=127.0.0.1
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
# Docker Desktop은 0. Linux는 getent group docker | cut -d: -f3
DOCKER_GID=0
# 수집 태스크 execution_timeout (분). 없으면 5
# EONJE_COLLECT_TIMEOUT_MIN=5
